{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-4-7[1m]",
  "preferredNotifyMethod": "terminal_bell",
  "alwaysThinkingEnabled": false,
  "outputStyle": "Explanatory",
  "voiceEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline/statusline-wrapper.sh",
    "refreshInterval": 5
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pretooluse-bash.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-secrets-wrapper.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/after-edit.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": [
        "~/.cache/uv",
        "~/.local/share/uv",
        "~/.local/bin",
        "~/go",
        "~/Library/Caches/go-build",
        "~/.npm",
        "~/.claude"
      ],
      "denyRead": [
        "~/.ssh"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "proxy.golang.org",
        "sum.golang.org",
        "storage.googleapis.com"
      ]
    }
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Edit(*)",
      "Write(*)",
      "Bash(~/.claude/hooks/mark-reviewed.sh)",
      "Bash(~/.claude/hooks/mark-reviewed.sh --security)",
      "Bash(~/.claude/hooks/mark-reviewed.sh --both)",
      "Bash(~/.claude/hooks/mark-reviewed.sh --tests)",
      "Bash(~/.claude/hooks/mark-reviewed.sh --docs)",
      "Bash(~/.claude/hooks/mark-reviewed.sh --all)",
      "Bash(~/.claude/hooks/mark-reviewed.sh --coverage *)",
      "mcp__context7__*",
      "mcp__github__*",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git branch)",
      "Bash(git branch -v)",
      "Bash(git branch -a)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(git config --get *)",
      "Bash(git config --list)",
      "Bash(git ls-files *)",
      "Bash(git stash list)",
      "Bash(git stash show *)",
      "Bash(git fetch)",
      "Bash(git fetch --all)",
      "Bash(git fetch origin)",
      "Bash(git add *)",
      "Bash(git restore --staged *)",
      "Bash(git commit -m *)",
      "Bash(git commit -am *)",
      "Bash(git commit --amend --no-edit)",
      "Bash(git checkout -- *)",
      "Bash(git checkout -b *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git tag)",
      "Bash(git tag -l *)",
      "Bash(git remote)",
      "Bash(git remote -v)",
      "Bash(git worktree list)",
      "Bash(go *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(pytest *)",
      "Bash(uv *)",
      "Bash(pip *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(cargo *)",
      "Bash(rustc *)",
      "Bash(make *)",
      "Bash(ansible-lint *)",
      "Bash(ansible-playbook *)",
      "Bash(ansible *)",
      "Bash(molecule *)",
      "Bash(gh *)",
      "Bash(jq *)",
      "Bash(yq *)",
      "Bash(eslint *)",
      "Bash(prettier *)",
      "Bash(tsc *)",
      "Bash(vitest *)",
      "Bash(jest *)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(black *)",
      "Bash(golangci-lint *)",
      "Bash(rustfmt *)",
      "Bash(clippy *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git reset --hard*)",
      "Bash(git rebase *)",
      "Bash(git rebase)",
      "Bash(git merge *)",
      "Bash(git merge)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git clean -fd*)",
      "Bash(git clean -f*)",
      "Bash(git stash drop *)",
      "Bash(git stash clear)",
      "Bash(git tag -d *)",
      "Bash(git remote add *)",
      "Bash(git remote remove *)",
      "Bash(git remote set-url *)",
      "Bash(git revert *)",
      "Bash(git cherry-pick *)",
      "Bash(git checkout main)",
      "Bash(git checkout master)",
      "Bash(git switch main)",
      "Bash(git switch master)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.production)",
      "Read(.env.staging)",
      "Read(./secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>",
    "pr": "Generated with [Claude Code](https://claude.com/claude-code)"
  },
  "spinnerTipsOverride": {
    "tips": [
      "Use /compact at ~70% context — don't wait for auto-compact",
      "Use /clear between unrelated tasks to reset context",
      "Start with /plan for complex features before coding",
      "Use Esc Esc or /rewind when Claude goes off-track",
      "Say 'ultrathink' in prompts for high-effort reasoning",
      "Use /context to check context window usage",
      "Use /voice for push-to-talk dictation (hold Space to record)",
      "Use /rc to control this session from your phone via claude.ai/code"
    ],
    "excludeDefault": false
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70"
  },
  "companyAnnouncements": [
    "Use /plan before complex features — design a phased approach before writing code",
    "Use /implement after a plan is approved — phased execution with quality gates",
    "Use /pr when ready to submit — structured PR with summary, changes, and test plan",
    "Use /compact at ~70% context (auto-compact is set to 70%) — don't wait until you're out of space",
    "Use /clear between unrelated tasks — fresh context prevents drift and hallucination",
    "Use Esc Esc or /rewind when Claude goes off-track — rewind beats fixing in-place",
    "Copy templates/mcp.json.example to .mcp.json in new projects for Context7 + Playwright",
    "Use /rc to remote-control sessions from mobile — scan QR with Claude app",
    "Use /voice for hands-free coding — push-to-talk with Space key",
    "Use /polish before releasing — fixes findings, scores readiness 0-100, and saves learnings automatically"
  ]
}
