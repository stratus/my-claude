# macOS
.DS_Store

# Editor
*.swp
*.swo
*~

# Local configuration
*.local
*.local.md
**/*.local.md

# Defense-in-depth: never commit auto-memory or per-project Claude state
# even if a developer accidentally creates these inside the repo tree.
projects/
memory/
review-markers/

# Per-target identity overlays — never committed (live in $CLAUDE_DIR, not the repo)
identity.json
**/identity.json
.gitconfig.d/

# Per-target statusline choice marker + extracted third-party source —
# never committed (live in $CLAUDE_DIR, not the repo). Defense-in-depth:
# the install target is normally outside the repo tree, but a developer
# could accidentally point CLAUDE_DIR inside the repo while testing.
statusline-choice
**/statusline-choice
external/
**/external/
