# macOS
.DS_Store

# Editor
*.swp
*.swo
*~

# Local configuration
*.local
*.local.md
**/*.local.md

# Defense-in-depth: never commit auto-memory or per-project Claude state
# even if a developer accidentally creates these inside the repo tree.
projects/
memory/
review-markers/
agent-memory-local/
**/agent-memory-local/

# Per-target identity overlays — never committed (live in $CLAUDE_DIR, not the repo)
identity.json
**/identity.json
.gitconfig.d/

# Leftovers from the removed third-party statusline backends. The repo no
# longer writes either, but a developer with an older deploy target could
# still have them on disk — and the install target is normally outside the
# repo tree, though CLAUDE_DIR could be pointed inside it while testing.
statusline-choice
**/statusline-choice
external/
**/external/
